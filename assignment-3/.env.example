# ---- LLM (any OpenAI-compatible endpoint or gateway) ----
# Default: Google Gemini (free tier) via its OpenAI-compatible endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Paste your key here (a free Gemini key works). If left blank, GEMINI_API_KEY from the environment is used.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Free tiers cap requests per model per day; when a model's daily quota is exhausted the
# client restarts the request on the next model in this list (never mixing models in one run).
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Client-side requests-per-minute cap (free tiers are rate limited) and retries on 429/5xx
LLM_RPM=8
LLM_MAX_RETRIES=5
LLM_TIMEOUT=90
# Optional: cache model responses on disk for reproducible offline eval re-runs
# LLM_CACHE_DIR=.cache/llm

# Examples for other gateways (only change the three LLM_* values):
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<model id listed by OpenRouter>
# LiteLLM proxy: LLM_BASE_URL=http://localhost:4000           LLM_MODEL=<your model alias>
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini

# ---- Local mock vendor-risk service ----
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
# auto = HTTP, falling back to the in-process mock if no server is running; http | inprocess
VENDOR_RISK_MODE=auto
UI_PORT=8501
